{
  "name": "@conduitcad/workbench",
  "version": "0.9.1",
  "description": "Modular Conduit CAD workbench engine",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@conduitcad/geometry": "0.9.1",
    "@conduitcad/spatial": "0.9.1",
    "@conduitcad/model": "0.9.1",
    "@conduitcad/history": "0.9.1",
    "@conduitcad/constraints": "0.9.1",
    "@conduitcad/routing": "0.9.1",
    "@conduitcad/symbols": "0.9.1",
    "@conduitcad/dxf": "0.9.1",
    "@conduitcad/renderer": "0.9.1",
    "@conduitcad/input": "0.9.1",
    "@conduitcad/storage": "0.9.1",
    "@conduitcad/exchange": "0.9.1",
    "@conduitcad/drawing": "0.9.1",
    "@conduitcad/workspace": "0.9.1",
    "@conduitcad/modeling": "0.9.1",
    "@conduitcad/renderer3d": "0.9.1",
    "@conduitcad/geometry3d": "0.9.1",
    "@conduitcad/icons": "0.9.1"
  }
}
