{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDir": "packages",
    "outDir": ".types"
  },
  "include": ["packages/*/src/*.js"],
  "exclude": ["packages/*/src/*.d.ts"]
}
