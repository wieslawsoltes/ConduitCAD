{
  "name": "conduit-cad-workspace",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "pack:packages": "node scripts/pack.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "catalog": "node scripts/catalog-artifacts.mjs",
    "test:symbols": "node --test tests/symbol-catalog.test.mjs",
    "samples:3d": "node scripts/modeling-samples.mjs",
    "test:3d": "node --test tests/modeling3d*.test.mjs",
    "icons": "node scripts/icon-atlas.mjs",
    "test:icons": "node --test tests/icons.test.mjs",
    "samples:rendering": "node scripts/rendering-samples.mjs",
    "test:rendering": "node --test tests/render-styles.test.mjs",
    "gallery:rendering": "node scripts/render-gallery.mjs",
    "test:visual": "node --test tests/manipulation3d.test.mjs",
    "test:planar": "node --test tests/manipulation2d.test.mjs",
    "samples:visual2d": "node scripts/visual-drafting-sample.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
